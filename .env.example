# Cloudflare Turnstile CAPTCHA Keys (Replace with your Cloudflare keys)
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Admin Authentication & Access Gate (Set your own secure values)
ADMIN_USER=your_admin_username
ADMIN_PASSWORD=your_admin_strong_password
ADMIN_PASS_HASH=
ADMIN_GATE_PASS=your_perimeter_gate_passcode
ADMIN_2FA_PIN=your_6_digit_pin
SITE_LOCK_PASSWORD=your_6_digit_lock_pass
JWT_SECRET=your_cryptographically_random_96_char_secret

# TorrServer Engine
TORRSERVER_URL=https://your-torrserver-host.example.com

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GCP_PROJECT_ID=your_gcp_project_id
