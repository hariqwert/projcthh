rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /system/{docId} {
      allow read, write: if true;
    }

    match /system_config/{docId} {
      allow read, write: if true;
    }

    match /m3u_playlists/{docId} {
      allow read, write: if true;
    }

    match /analytics/{docId} {
      allow read, write: if true;
    }
  }
}

